{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compair.dev/protocol/baseline-repository-discovery.v1.schema.json",
  "title": "baseline-repository-discovery.v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "identity_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "authority", "repository_uid"],
      "properties": {
        "version": {"const": "repository-identity.v1"},
        "authority": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "repository_uid": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_id",
        "group_id",
        "identity_descriptor_hash",
        "identity_descriptor",
        "state",
        "source_document_id",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "registration_id": {"$ref": "#/$defs/uuid"},
        "group_id": {"$ref": "#/$defs/group_id"},
        "identity_descriptor_hash": {"$ref": "#/$defs/sha256"},
        "identity_descriptor": {"$ref": "#/$defs/identity_descriptor"},
        "state": {"enum": ["active", "disabled"]},
        "source_document_id": {
          "oneOf": [
            {"$ref": "#/$defs/uuid"},
            {"type": "null"}
          ]
        },
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "group_id"],
      "properties": {
        "schema_version": {"const": "baseline-repository-discovery.v1"},
        "message_type": {"const": "repository_list_request"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "group_id": {"$ref": "#/$defs/group_id"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "group_id", "registration_id"],
      "properties": {
        "schema_version": {"const": "baseline-repository-discovery.v1"},
        "message_type": {"const": "repository_inspect_request"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "group_id": {"$ref": "#/$defs/group_id"},
        "registration_id": {"$ref": "#/$defs/uuid"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "group_id", "repositories"],
      "properties": {
        "schema_version": {"const": "baseline-repository-discovery.v1"},
        "message_type": {"const": "repository_list"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "group_id": {"$ref": "#/$defs/group_id"},
        "repositories": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/repository"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "group_id", "repository"],
      "properties": {
        "schema_version": {"const": "baseline-repository-discovery.v1"},
        "message_type": {"const": "repository_inspection"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "group_id": {"$ref": "#/$defs/group_id"},
        "repository": {"$ref": "#/$defs/repository"}
      }
    }
  ]
}
