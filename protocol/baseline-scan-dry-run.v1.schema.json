{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compair.dev/protocol/baseline-scan-dry-run.v1.schema.json",
  "title": "baseline-scan-dry-run.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "protocol_sha256", "group_id", "changed_repository", "sibling_repositories", "snapshot_id", "canonical_manifest_hash", "scan_plan_jcs_sha256", "content_manifest_hash", "counts", "skip_reason_counts", "raw_diff", "parts", "manifest_request_bytes", "commit_request_bytes", "maximum_planned_upload_bytes", "scan_fingerprint", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "baseline-scan-dry-run.v1"},
    "protocol_version": {"const": "baseline-control-plane.v1"},
    "protocol_sha256": {"const": "3b45287a54d04cea751e9cc3209c5f0783192de13062e682eadcae40af322650"},
    "group_id": {"$ref": "#/$defs/group_id"},
    "changed_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_registration_id", "base_revision", "head_revision", "source_document_id"],
      "properties": {
        "repository_registration_id": {"$ref": "#/$defs/identifier"},
        "base_revision": {"$ref": "#/$defs/revision"},
        "head_revision": {"$ref": "#/$defs/revision"},
        "source_document_id": {"$ref": "#/$defs/uuid"}
      }
    },
    "sibling_repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_registration_id", "revision"],
        "properties": {
          "repository_registration_id": {"$ref": "#/$defs/identifier"},
          "revision": {"$ref": "#/$defs/revision"}
        }
      }
    },
    "snapshot_id": {"type": "string", "pattern": "^bsnap_[0-9a-f]{64}$"},
    "canonical_manifest_hash": {"$ref": "#/$defs/hash"},
    "scan_plan_jcs_sha256": {"$ref": "#/$defs/hash"},
    "content_manifest_hash": {"$ref": "#/$defs/hash"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_count", "file_count", "supported_file_count", "skipped_file_count", "supported_content_bytes"],
      "properties": {
        "repository_count": {"type": "integer", "minimum": 1, "maximum": 128},
        "file_count": {"type": "integer", "minimum": 0, "maximum": 50000},
        "supported_file_count": {"type": "integer", "minimum": 0, "maximum": 50000},
        "skipped_file_count": {"type": "integer", "minimum": 0, "maximum": 50000},
        "supported_content_bytes": {"type": "integer", "minimum": 0, "maximum": 512000000}
      }
    },
    "skip_reason_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_utf8", "oversized", "symlink", "excluded_directory", "unsupported_file_type", "unreadable"],
      "properties": {
        "non_utf8": {"$ref": "#/$defs/count"},
        "oversized": {"$ref": "#/$defs/count"},
        "symlink": {"$ref": "#/$defs/count"},
        "excluded_directory": {"$ref": "#/$defs/count"},
        "unsupported_file_type": {"$ref": "#/$defs/count"},
        "unreadable": {"$ref": "#/$defs/count"}
      }
    },
    "raw_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "base_revision", "head_revision", "byte_size", "sha256"],
      "properties": {
        "representation": {"const": "raw_git_diff_v1"},
        "base_revision": {"$ref": "#/$defs/revision"},
        "head_revision": {"$ref": "#/$defs/revision"},
        "byte_size": {"type": "integer", "minimum": 0, "maximum": 8000000},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "parts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_ordinal", "part_sha256", "file_count", "decoded_content_bytes", "request_bytes"],
        "properties": {
          "part_ordinal": {"type": "integer", "minimum": 1, "maximum": 512},
          "part_sha256": {"$ref": "#/$defs/hash"},
          "file_count": {"type": "integer", "minimum": 1, "maximum": 1000},
          "decoded_content_bytes": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "request_bytes": {"type": "integer", "minimum": 1, "maximum": 8000000}
        }
      }
    },
    "manifest_request_bytes": {"type": "integer", "minimum": 1, "maximum": 32000000},
    "commit_request_bytes": {"type": "integer", "minimum": 1, "maximum": 64000},
    "maximum_planned_upload_bytes": {"type": "integer", "minimum": 2},
    "scan_fingerprint": {"$ref": "#/$defs/hash"},
    "warnings": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "dry_run_only"}, {"const": "no_network_or_persistence"}], "items": false},
    "errors": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "uuid": {"type": "string", "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"},
    "group_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 50000}
  }
}
