    },
    {
      "case_id": "duplicate_nested_retrieval_query_hash",
      "expected_error": "duplicate_json_key",
      "raw_json": "{\"protocol_version\":\"baseline-control-plane.v2\",\"protocol_sha256\":\"b278abe007779f05e92509db068f555701c03cba5cf236151e8df231a9b44091\",\"message_type\":\"run_submit\",\"request_id\":\"00000000-0000-4000-8000-000000000021\",\"group_id\":\"group-toy-v2\",\"retrieval_query\":{\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"sha256\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}}"
    },
    {
      "case_id": "duplicate_protocol_hash",
      "expected_error": "duplicate_json_key",
      "raw_json": "{\"protocol_version\":\"baseline-control-plane.v2\",\"protocol_sha256\":\"b278abe007779f05e92509db068f555701c03cba5cf236151e8df231a9b44091\",\"protocol_sha256\":\"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\",\"message_type\":\"capabilities_request\",\"request_id\":\"00000000-0000-4000-8000-000000000023\",\"group_id\":\"group-toy-v2\"}"
