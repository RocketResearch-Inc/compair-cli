{
  "schema_version": "baseline-control-plane.v2-invalid-fixtures.v1",
  "cases": [
    {
      "case_id": "protocol_version_mismatch",
      "expected_error": "schema_invalid",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "set",
        "path": "/protocol_version",
        "value": "baseline-control-plane.v1"
      }
    },
    {
      "case_id": "protocol_hash_mismatch",
      "expected_error": "protocol_mismatch",
      "base": { "message_type": "index_build_submit", "occurrence": 1 },
      "mutation": {
        "operation": "set",
        "path": "/protocol_sha256",
        "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      }
    },
    {
      "case_id": "obsolete_unreleased_v2_hash_rejected",
      "expected_error": "protocol_mismatch",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "set",
        "path": "/protocol_sha256",
        "value": "c9486b3deb1a494781513109df17d8e8df1281fbc9687960ace711485b50d174"
      }
    },
    {
      "case_id": "missing_index_group_authorization",
      "expected_error": "schema_invalid",
      "base": { "message_type": "index_build_submit", "occurrence": 1 },
      "mutation": {
        "operation": "delete",
        "path": "/group_id"
      }
    },
    {
      "case_id": "missing_run_source_document_authorization",
      "expected_error": "schema_invalid",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "delete",
        "path": "/source_document_id"
      }
    },
    {
      "case_id": "missing_run_changed_registration_authorization",
      "expected_error": "schema_invalid",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "delete",
        "path": "/changed_repository_registration_id"
      }
    },
    {
      "case_id": "client_parent_processing_identity_forbidden",
      "expected_error": "schema_invalid",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "set",
        "path": "/parent_processing_key",
        "value": "client-must-not-control-this-value"
      }
    },
    {
      "case_id": "retrieval_query_hash_mismatch",
      "expected_error": "semantic_hash_mismatch",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "set",
        "path": "/retrieval_query/sha256",
        "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      }
    },
    {
      "case_id": "retrieval_query_byte_size_mismatch",
      "expected_error": "semantic_size_mismatch",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "set",
        "path": "/retrieval_query/byte_size",
        "value": 148
      }
    },
    {
      "case_id": "oversized_retrieval_query",
      "expected_error": "limit_exceeded",
      "base": { "message_type": "run_submit", "occurrence": 1 },
      "mutation": {
        "operation": "repeat_ascii",
        "path": "/retrieval_query/text",
        "character": "x",
        "count": 8000001,
        "synchronize_declared_size_and_hash": true
      }
    },
    {
      "case_id": "insufficient_with_reference_write",
      "expected_error": "invalid_state_combination",
      "base": { "operation": "baseline_run", "state": "insufficient" },
      "mutation": {
        "operation": "set",
        "path": "/effects/reference_count",
        "value": 1
      }
    },
