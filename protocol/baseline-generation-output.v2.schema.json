{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compair.dev/protocol/baseline-generation-output.v2.schema.json",
  "title": "Compair baseline generation output v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "outcome", "findings"],
      "properties": {
        "schema_version": { "const": "baseline-generation-output.v2" },
        "outcome": { "const": "no_findings" },
        "findings": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "outcome", "findings"],
      "properties": {
        "schema_version": { "const": "baseline-generation-output.v2" },
        "outcome": { "const": "findings" },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback"],
      "properties": {
        "feedback": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(.|\\n|\\r|\\u2028|\\u2029)*[^\\t-\\r\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n|\\r|\\u2028|\\u2029)*$"
        }
      }
    }
  }
}
